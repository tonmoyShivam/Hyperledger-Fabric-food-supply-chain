# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# Hyperledger Fabric
FABRIC_CHANNEL_NAME=foodchannel
FABRIC_CHAINCODE_NAME=foodtrace
FABRIC_GATEWAY_PEER=localhost:7051
FABRIC_MOCK=false

# Crypto material roots (relative to backend/)
FABRIC_CRYPTO_PATH=../blockchain/network/organizations
FABRIC_PEER_ORG_PATH=../blockchain/network/organizations/peerOrganizations

# Demo mode enables seeded local users (password: Password123!)
DEMO_MODE=false

# Logging
LOG_LEVEL=info
